# Edge function secrets
#
# Set these on the Supabase project before the agents will run:
#   supabase secrets set --env-file supabase/.env.example
#
# Nothing in this file reaches the client bundle. The VITE_ variables live in
# the project root .env instead.

# Required for both agents.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b. Set to groq/compound for the
# Groq-managed web-search and code-execution path.
DESIGNLY_GROQ_MODEL=

# Served automatically inside every function; listed here for reference only.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
